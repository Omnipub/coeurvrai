# L'API est servie sur le même domaine que le site (/api, /socket.io).
# En développement, Next.js relaie ces chemins vers BACKEND_URL (next.config.mjs).
BACKEND_URL=http://localhost:3001
# Ne renseigner que pour appeler une API sur un autre domaine (déconseillé : cookies).
NEXT_PUBLIC_API_URL=

# Clé publique Stripe (abonnements, à venir)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# URL publique canonique du site (metadata, canonical, sitemap, JSON-LD, llms.txt)
NEXT_PUBLIC_SITE_URL=https://coeurvrai.com

# Hôtes d'images optimisées par next/image (vide : les photos de profil passent par URL signées)
NEXT_PUBLIC_IMAGE_HOSTS=
