# URL publique de l'API Express (REST + Socket.io)
NEXT_PUBLIC_API_URL=http://localhost:3001

# Clé publique Stripe (abonnements, à venir)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# URL publique canonique du site (metadata, canonical, sitemap, JSON-LD, llms.txt)
