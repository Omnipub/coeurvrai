# =============================================================================
# Cœur Vrai — variables de PRODUCTION (modèle)
# =============================================================================
# Le vrai fichier s'appelle .env.production. Il est créé SUR LE SERVEUR par
#   infra/generate-secrets.sh
# qui remplace chaque valeur « <généré> » par un secret fort. Il n'est JAMAIS
# commité (voir .gitignore). Droits : chmod 600, propriétaire « deploy ».
# Les valeurs « <à renseigner> » sont à compléter à la main (OVH, Brevo, Onfido…).
# =============================================================================

# --- Version déployée (mise à jour automatiquement par infra/deploy.sh)
APP_VERSION=<à renseigner>
# Registre des images (GitHub Container Registry). Aucune donnée ni secret dans les images.
IMAGE_REGISTRY=ghcr.io/omnipub/coeurvrai

# --- Domaines
# Domaine principal, servi en HTTPS.
SITE_DOMAIN=coeurvrai.com
# Domaines redirigés en 301 vers https://coeurvrai.com (chemin conservé), séparés par des virgules.
REDIRECT_DOMAINS=www.coeurvrai.com, coeur-vrai.com, www.coeur-vrai.com, coeurvrai.fr, www.coeurvrai.fr, coeur-vrai.fr, www.coeur-vrai.fr
# Adresse e-mail transmise à Let's Encrypt (avertissements d'expiration de certificat).
ACME_EMAIL=<à renseigner>
# Options globales Caddy supplémentaires (vide en production).
CADDY_GLOBAL_OPTIONS=

# --- PostgreSQL 15 (conteneur local au VPS ; phase 2 : PostgreSQL managé OVH)
# Superutilisateur, utilisé uniquement à l'initialisation du volume.
POSTGRES_PASSWORD=<généré>
# Propriétaire du schéma : migrations, sauvegardes, test de restauration.
PG_OWNER_USER=coeurvrai_owner
PG_OWNER_PASSWORD=<généré>
# Utilisateur de l'application : lecture/écriture des données uniquement.
PG_APP_USER=coeurvrai_app
PG_APP_PASSWORD=<généré>
# Chaînes de connexion. L'application ne lit la base QUE par DATABASE_URL.
# Phase 2 (base managée) : remplacer l'hôte et ajouter ?sslmode=require — rien d'autre.
DATABASE_URL=<généré>
MIGRATION_DATABASE_URL=<généré>

# --- Redis (mot de passe obligatoire)
REDIS_PASSWORD=<généré>

# --- Application
# Signature des sessions (jeton porté par un cookie HttpOnly).
JWT_SECRET=<généré>
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12
# Clés de chiffrement AES-256-GCM des champs sensibles : « id:base64 », la première chiffre.
# Rotation : voir infra/EXPLOITATION.md. NE JAMAIS PERDRE une clé encore utilisée.
ENCRYPTION_KEYS=<généré>
# Pseudonymisation des identifiants dans les journaux.
LOG_PSEUDONYM_KEY=<généré>
# Purges RGPD automatiques (cron, heure de Paris).
CLEANUP_CRON=0 3 * * *

# --- E-mails transactionnels : Brevo (SMTP)
# Format : smtp://IDENTIFIANT:CLE_SMTP@smtp-relay.brevo.com:587  (encoder « @ » en %40 dans l'identifiant)
SMTP_URL=<à renseigner>
SMTP_REQUIRE_TLS=true
MAIL_FROM=Cœur Vrai <noreply@coeurvrai.com>

# --- OVH Object Storage — bucket PRIVÉ des photos (S3)
S3_BUCKET_PHOTOS=coeurvrai-photos
# Point d'accès S3 de la région (ex. Gravelines : https://s3.gra.io.cloud.ovh.net)
S3_ENDPOINT=https://s3.gra.io.cloud.ovh.net
# Adresse utilisée pour signer les URL vues par les navigateurs (vide = S3_ENDPOINT).
S3_PUBLIC_ENDPOINT=
# Origine autorisée pour les images dans la politique CSP (= point d'accès S3 public).
S3_PUBLIC_ORIGIN=https://s3.gra.io.cloud.ovh.net
S3_REGION=gra
S3_FORCE_PATH_STYLE=true
# Clé S3 de l'APPLICATION : lecture/écriture sur le bucket photos UNIQUEMENT.
S3_ACCESS_KEY_ID=<à renseigner>
S3_SECRET_ACCESS_KEY=<à renseigner>
# Durée de vie des URL signées des photos, en secondes (300 à 900).
PHOTO_URL_TTL_SECONDS=600
# Photos floutées pour les hommes sans abonnement (laisser false tant que l'abonnement n'existe pas).
PHOTO_BLUR_FOR_NON_SUBSCRIBERS=false

# --- Onfido (vérification d'identité par selfie, facultative)
ONFIDO_API_TOKEN=
ONFIDO_REGION=EU
ONFIDO_WORKFLOW_ID=
ONFIDO_WEBHOOK_TOKEN=

# --- Sauvegardes (restic → bucket « sauvegardes » d'OVH Object Storage)
# Format : s3:https://s3.gra.io.cloud.ovh.net/coeurvrai-sauvegardes
RESTIC_REPOSITORY=s3:https://s3.gra.io.cloud.ovh.net/coeurvrai-sauvegardes
# MOT DE PASSE DES SAUVEGARDES. À COPIER DANS LE GESTIONNAIRE DE MOTS DE PASSE DE SYLVAIN.
# SANS LUI, LES SAUVEGARDES SONT ILLISIBLES ET IRRÉCUPÉRABLES.
RESTIC_PASSWORD=<généré>
# Clé S3 DÉDIÉE aux sauvegardes (bucket sauvegardes uniquement ; l'application ne doit pas y avoir accès).
BACKUP_S3_ACCESS_KEY_ID=<à renseigner>
BACKUP_S3_SECRET_ACCESS_KEY=<à renseigner>
# Lecture du bucket photos pour leur sauvegarde (clé en LECTURE SEULE de préférence ; vide = clé de l'application).
PHOTOS_BACKUP_ACCESS_KEY_ID=
PHOTOS_BACKUP_SECRET_ACCESS_KEY=

# --- Alertes (échec de sauvegarde, disque > 80 %)
ALERT_EMAIL_TO=<à renseigner>
ALERT_EMAIL_FROM=noreply@coeurvrai.com
DISK_ALERT_THRESHOLD=80
# Facultatif : URL de ping d'un service de surveillance (ex. Healthchecks auto-hébergé).
HEALTHCHECK_URL=
