# Variables de la pile LOCALE (docker-compose.local.yml).
# TOUTES LES VALEURS SONT FACTICES : ne jamais les réutiliser ailleurs.
APP_VERSION=local
SITE_DOMAIN=coeurvrai.com
REDIRECT_DOMAINS=www.coeurvrai.com, coeur-vrai.com, www.coeur-vrai.com, coeurvrai.fr, www.coeurvrai.fr, coeur-vrai.fr, www.coeur-vrai.fr
ACME_EMAIL=local@example.invalid
CADDY_GLOBAL_OPTIONS=local_certs
S3_PUBLIC_HOST=s3.coeurvrai.localhost
S3_PUBLIC_ORIGIN=https://s3.coeurvrai.localhost

POSTGRES_PASSWORD=local-postgres-superuser-password
PG_OWNER_USER=coeurvrai_owner
PG_OWNER_PASSWORD=local-owner-password
PG_APP_USER=coeurvrai_app
PG_APP_PASSWORD=local-app-password
DATABASE_URL=postgres://coeurvrai_app:local-app-password@postgres:5432/coeurvrai
MIGRATION_DATABASE_URL=postgres://coeurvrai_owner:local-owner-password@postgres:5432/coeurvrai
REDIS_PASSWORD=local-redis-password

JWT_SECRET=local-jwt-secret-not-for-production-0000000000000000000000000000
ENCRYPTION_KEYS=local:AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8=
LOG_PSEUDONYM_KEY=local-log-pseudonym-key
BCRYPT_ROUNDS=10

SMTP_URL=smtp://mailpit:1025
SMTP_REQUIRE_TLS=false
MAIL_FROM=Cœur Vrai <noreply@coeurvrai.com>
ALERT_EMAIL_TO=alertes@example.invalid

S3_BUCKET_PHOTOS=coeurvrai-photos
S3_ENDPOINT=http://seaweedfs:8333
S3_PUBLIC_ENDPOINT=https://s3.coeurvrai.localhost
S3_REGION=gra
S3_ACCESS_KEY_ID=local-test-access-key
S3_SECRET_ACCESS_KEY=local-test-secret-key-not-for-production
S3_FORCE_PATH_STYLE=true

RESTIC_REPOSITORY=s3:http://seaweedfs:8333/coeurvrai-sauvegardes
RESTIC_PASSWORD=local-restic-password-not-for-production
BACKUP_S3_ACCESS_KEY_ID=local-test-access-key
BACKUP_S3_SECRET_ACCESS_KEY=local-test-secret-key-not-for-production
