# --- Serveur ---
NODE_ENV=development
PORT=3001
# Origine autorisée pour CORS et Socket.io (URL du frontend)
CORS_ORIGIN=http://localhost:3000

# --- PostgreSQL 15 ---
DATABASE_URL=postgres://coeurvrai:coeurvrai@localhost:5432/coeurvrai

# --- Redis (file de modération, rate limiting) ---
REDIS_URL=redis://localhost:6379

# --- Authentification ---
# Générer avec : openssl rand -hex 64
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# --- Stripe (abonnements, à venir) ---
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
