# --- Serveur ---
NODE_ENV=development
PORT=3001
# Origine autorisée pour CORS et Socket.io (URL du frontend)
CORS_ORIGIN=http://localhost:3000

# --- PostgreSQL 15 ---
DATABASE_URL=postgres://coeurvrai:coeurvrai@localhost:5432/coeurvrai

# --- Redis (file de modération, rate limiting) ---
REDIS_URL=redis://localhost:6379

# --- Authentification ---
# Générer avec : openssl rand -hex 64
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# --- Purges RGPD automatiques (comptes inactifs, signalements clos, IP > 1 an) ---
# Expression cron, heure de Paris. Laisser vide pour désactiver sur cette instance.
CLEANUP_CRON=0 3 * * *

# --- E-mails (vérification d'adresse, préavis) ---
# URL publique du frontend, utilisée dans les liens des e-mails
APP_URL=http://localhost:3000
# Vide en développement : les e-mails sont affichés dans la console au lieu d'être envoyés
SMTP_URL=
MAIL_FROM="Cœur Vrai <no-reply@coeur-vrai.com>"

# --- Onfido (vérification d'identité par selfie, facultative) ---
# Jeton API (dashboard Onfido › Developers › Tokens). Vide : fonctionnalité désactivée.
ONFIDO_API_TOKEN=
# Région du compte Onfido : EU (recommandé, données dans l'UE), US ou CA
ONFIDO_REGION=EU
# Identifiant du workflow Onfido Studio (ex. « Selfie liveness »)
ONFIDO_WORKFLOW_ID=
# Jeton de signature du webhook pointant vers POST /api/verification/onfido-check
ONFIDO_WEBHOOK_TOKEN=

# --- Stripe (abonnements, à venir) ---
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
